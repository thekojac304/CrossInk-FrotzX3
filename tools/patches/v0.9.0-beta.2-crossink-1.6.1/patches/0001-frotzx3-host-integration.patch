@@ -232,7 +232,13 @@ def inject_version(env):
         print(f'CrossInk RC build version: {version_string}')
 
     # Keep changing source identity out of unrelated compile commands.
-    if hasattr(env, 'AddBuildMiddleware'):
+    # FrotzX3 build-tooling fix, no firmware logic: pioarduino's Windows-only
+    # include-length wrapper replays every registered build middleware for every
+    # framework source and ignores the '*src/util/BuildInfo.cpp' pattern. That
+    # compiles FrameworkArduino objects twice with different flags and SCons stops
+    # with "Two environments with different actions". Use the global-defines
+    # fallback on Windows (the behavior before middleware was introduced).
+    if hasattr(env, 'AddBuildMiddleware') and os.name != 'nt':
         def add_build_info_defines(node_env, node):
             build_env = node_env.Clone()
             build_env.Append(CPPDEFINES=scoped)
